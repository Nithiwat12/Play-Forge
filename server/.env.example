# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/board_game_platform?schema=public"

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN="http://localhost:5173"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Cookies
COOKIE_NAME="bgp_token"
